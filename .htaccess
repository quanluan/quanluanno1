<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header to PHP in FastCGI / PHP-FPM
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Route /api/* to PHP 7.4 API backend
  RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

  # Existing files and directories served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.php
  RewriteRule . index.php [L]
</IfModule>

# Ensure PHP index takes priority over index.html
DirectoryIndex index.php index.html

# MIME types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>
